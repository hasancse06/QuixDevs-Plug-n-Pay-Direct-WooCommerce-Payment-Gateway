# Installed development dependencies; retain manifests and lockfiles.
/vendor/
/node_modules/
/.composer-cache/

# Test, standards and coverage output; retain *.dist configuration templates.
/.phpunit.result.cache
/.phpunit.cache/
/.phpunit/
/.phpcs-cache
/.phpcs-cache/
/coverage/
/.coverage
/.pytest_cache/
/phpcs.json
/activation.log
__pycache__/
*.py[cod]

# Local site/test configuration, credentials and private material.
.env
.env.*
!.env.example
/wp-config.php
/wp-tests-config.php
/local-config.php
/phpunit.xml
/phpcs.xml
/.phpcs.xml
/auth.json
*.pem
*.key
*.p12
*.pfx
/private/
/snapshots/
/backups/
/customer-exports/
/merchant-config.*

# Generated archives, build output, databases and logs.
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.sql
*.sql.gz
*.sqlite*
*.db
*.log
/dist/
/build/
/.release/
/artifacts/
/tmp/
/temp/
/docs/verification/
/docs/source-hashes.json

# Editors and operating-system metadata.
/.idea/
/.vscode/
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
*.orig
*.rej

# Intentionally tracked: runtime source, tests, .github, Composer manifests/lock,
