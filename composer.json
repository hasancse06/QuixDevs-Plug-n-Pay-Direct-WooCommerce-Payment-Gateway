{
  "name": "quixdevs/quixdevs-plugnpay-direct",
  "description": "Local GitHub distribution candidate for the Plug'n Pay Direct WooCommerce gateway.",
  "type": "project",
  "require": {"php": ">=8.2"},
  "require-dev": {"phpunit/phpunit": "^9.6", "squizlabs/php_codesniffer": "^3.13", "wp-coding-standards/wpcs": "^3.2", "dealerdirect/phpcodesniffer-composer-installer": "^1.0"},
  "config": {"allow-plugins": {"dealerdirect/phpcodesniffer-composer-installer": true}},
  "scripts": {"test": "phpunit", "lint": "python3 tools/lint.py", "phpcs": "python3 tools/run-phpcs.py", "secrets": "python3 tools/secret-scan.py", "docs": "python3 tools/verify-docs.py", "package-check": "python3 tools/build-release.py --check", "release-check": "python3 tools/check-publication.py"}
}
