<?xml version="1.0"?>
<ruleset name="QuixDevs PlugNPay Direct">
  <description>Full WordPress rules; known WooCommerce and explicitly provisioned backend capabilities.</description>
  <rule ref="WordPress"/>
  <rule ref="WordPress.WP.Capabilities">
    <properties><property name="custom_capabilities" type="array">
      <element value="quixdevs_plugnpay_pay_orders"/>
      <element value="edit_shop_order"/>
    </property></properties>
  </rule>
</ruleset>
